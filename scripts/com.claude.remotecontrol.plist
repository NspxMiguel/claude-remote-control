<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd service for claude-remote-control.

  1. Edit ProgramArguments below so the paths match your machine
     (`which node` and the absolute path to bin/crc.js).
  2. cp scripts/com.claude.remotecontrol.plist ~/Library/LaunchAgents/
  3. launchctl load -w ~/Library/LaunchAgents/com.claude.remotecontrol.plist

  Logs land in ~/Library/Logs/claude-remote-control.log.
  Stop it with: launchctl unload -w ~/Library/LaunchAgents/com.claude.remotecontrol.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude.remotecontrol</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/CHANGEME/claude-remote-control/bin/crc.js</string>
    <string>start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Claude Code needs a real PATH to find git, ripgrep and friends. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/CHANGEME/Library/Logs/claude-remote-control.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/CHANGEME/Library/Logs/claude-remote-control.log</string>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
